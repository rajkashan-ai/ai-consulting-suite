# The repository root moved up one level on 2026-09-17. It used to sit inside
# web/, which left the instruction files, the six agent specs and every decision
# record outside version control: no history, no backup, and nothing to recover
# from if one was overwritten.
#
# The consequence for this file: rules that were anchored to the old root, like
# "/node_modules", now point at the wrong place. They are unanchored here so
# they match wherever they appear.

# Dependencies and build output, wherever they are.
node_modules/
.next/
out/
build/
dist/
.vercel/
coverage/

# Secrets. Never opt in: the Anthropic key and the database keys live here.
.env
.env.*
!.env.local.example

# macOS and editor noise.
.DS_Store
*.pem
*.tsbuildinfo

# Logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next writes this and it is regenerated on every build.
web/next-env.d.ts

# Point-in-time copies of real customer rows, taken before deleting any.
# Business data: kept on disk for recovery, never in version control.
backups/
